; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but can also be edited by text editors.

config_version=5

[application]

config/name="CyberHorde: Rogue Protocol"
config/description="Fast-paced horde FPS roguelike shooter with dynamic upgrades and loot."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SoundManager="*res://scripts/autoload/sound_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
textures/vram_compression/import_etc2_astc=false
